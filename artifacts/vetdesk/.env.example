# Email Service Configuration
# Choose one of the following email service providers and configure accordingly

# Option 1: Resend (recommended for production)
VITE_EMAIL_SERVICE_URL=https://api.resend.com/emails
VITE_EMAIL_SERVICE_API_KEY=your_resend_api_key_here

# Option 2: SendGrid
# VITE_EMAIL_SERVICE_URL=https://api.sendgrid.com/v3/mail/send
# VITE_EMAIL_SERVICE_API_KEY=your_sendgrid_api_key_here

# Option 3: Custom SMTP endpoint
# VITE_EMAIL_SERVICE_URL=https://your-smtp-endpoint.com/send
# VITE_EMAIL_SERVICE_API_KEY=your_smtp_api_key_here

# For development/testing, you can use the mock email service
# Set these to empty strings to use mock mode (emails will be logged to console)
# VITE_EMAIL_SERVICE_URL=
# VITE_EMAIL_SERVICE_API_KEY=
